@final
class NetHost:
    def __new__(
        cls,
        name: str,
        product_instance_id: str,
        auth: int = 0,
        random: Callable[[int], bytes] | None = None,
    ) -> NetHost: ...
    def receive(
        self, now_ms: int, peer: _Address, payload: bytes
    ) -> tuple[list[NetEvent], list[tuple[_Address, bytes]]]: ...
    def poll(self, now_ms: int) -> list[NetEvent]: ...
    def write_pending(self, now_ms: int) -> list[tuple[_Address, bytes]]: ...
    def next_deadline(self) -> int | None: ...
    def send_ump(self, peer: _Address, words: list[int]) -> None: ...
    def ping(self, now_ms: int, peer: _Address) -> int: ...
    def bye(self, now_ms: int, peer: _Address, reason: int = 1) -> list[NetEvent]: ...
    @property
    def dropped_events(self) -> int: ...
    def set_shared_secret(self, secret: bytes | None) -> None:
        """Sets the shared secret. The Host keeps a copy, which it clears when the secret is
        replaced or the Host goes; the bytes object of the caller is not cleared."""
    def set_users(self, users: dict[str, bytes]) -> None:
        """Sets the user table. The Host keeps copies of the passwords, which it clears when the
        table is replaced or the Host goes; the bytes objects of the caller are not cleared."""
    def add_random(self, data: bytes) -> None: ...
    @property
    def random_left(self) -> int: ...

@final
class NetClient:
    def __new__(cls, name: str, product_instance_id: str, auth: int = 0) -> NetClient: ...
    def connect(self, now_ms: int, host: _Address) -> None: ...
    def receive(
        self, now_ms: int, peer: _Address, payload: bytes
    ) -> tuple[list[NetEvent], list[tuple[_Address, bytes]]]: ...
    def poll(self, now_ms: int) -> list[NetEvent]: ...
    def write_pending(self, now_ms: int) -> list[tuple[_Address, bytes]]: ...
    def next_deadline(self) -> int | None: ...
    def send_ump(self, peer: _Address, words: list[int]) -> None: ...
    def ping(self, now_ms: int, peer: _Address) -> int: ...
    def bye(self, now_ms: int, peer: _Address, reason: int = 1) -> list[NetEvent]: ...
    @property
    def dropped_events(self) -> int: ...
    def set_shared_secret(self, secret: bytes | None) -> None:
        """Sets the shared secret. The Client keeps a copy, which it clears when the secret is
        replaced or the Client goes; the bytes object of the caller is not cleared."""
    def set_user(self, username: str | None, password: bytes = ...) -> None:
        """Sets the Username and the password. The Client keeps a copy of the password, which it
        clears when it is replaced or the Client goes; the bytes object of the caller is not
        cleared."""
