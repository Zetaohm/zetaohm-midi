@final
class PeEngine:
    def __new__(cls, resources: list[PeResource] = ...) -> PeEngine: ...
    def receive(self, dev: CiDevice, now_us: int) -> PeEvent | None: ...
    def poll(self, dev: CiDevice, now_us: int) -> PeEvent | None: ...
    def write_pending(self, dev: CiDevice, now_us: int) -> bytes | None: ...
    def reply(
        self,
        dev: CiDevice,
        peer: int,
        request_id: int,
        status: int = 200,
        length: int | None = ...,
        encoding: str = "ASCII",
        media_type: str | None = None,
        total_count: int | None = None,
        cache_time: int | None = None,
        now_us: int = 0,
    ) -> None: ...
    def reply_status(
        self, dev: CiDevice, peer: int, request_id: int, status: int, now_us: int = 0
    ) -> None: ...
    def update(
        self,
        dev: CiDevice,
        index: int,
        command: str,
        length: int | None = ...,
        encoding: str = "ASCII",
        now_us: int = 0,
    ) -> int: ...
    def resource_list(self) -> bytes: ...
    def request(
        self,
        dev: CiDevice,
        peer: int,
        kind: str,
        resource: str,
        res_id: str | None = None,
        media_type: str | None = None,
        offset: int | None = None,
        limit: int | None = None,
        set_partial: bool = False,
        encoding: str = "ASCII",
        length: int | None = ...,
        caps: PeResource | None = None,
        now_us: int = 0,
    ) -> tuple[int, bool]: ...
    def request_resource_list(
        self, dev: CiDevice, peer: int, now_us: int = 0
    ) -> tuple[int, bytes]: ...
    def subscribe(
        self,
        dev: CiDevice,
        peer: int,
        resource: str,
        res_id: str | None = None,
        encoding: str = "ASCII",
        caps: PeResource | None = None,
        now_us: int = 0,
    ) -> tuple[int, bool]: ...
    def unsubscribe(self, dev: CiDevice, index: int, now_us: int = 0) -> int: ...
    def refresh(self, index: int) -> None: ...
    def data_room(self, dev: CiDevice, peer: int, request_id: int, role: str) -> int: ...
    def send(
        self,
        dev: CiDevice,
        peer: int,
        request_id: int,
        role: str,
        part: bytes,
        last: bool,
        now_us: int = 0,
    ) -> bytes: ...
    def wait(self, peer: int, request_id: int, role: str, ms: int) -> None: ...
    def abort(self, dev: CiDevice, peer: int, request_id: int, role: str) -> None: ...
    def corrupt(self, peer: int, request_id: int, role: str) -> None: ...
    def subscription(self, index: int) -> PeSubscription | None: ...
    def take_ended(self) -> PeSubscription | None: ...

