+//! PROTOTYPE (size experiment, not reviewed): a one-chunk Property Exchange Responder.
+//! Get and Set of Resources whose Header and Property Data fit in one Chunk; no transaction
+//! table, no subscriptions, no flow control, ASCII only. A request in more than one Chunk gets
+//! 413 (M2-103 7.4.1 Table 15).
+
+use zmidi_ci::{CiDevice, Event, Muid, PeKind};
+
+/// The Resources of the application.
+pub trait SimpleResources {
+    /// Writes the Property Data of `resource` into `out`; gives its length or a status.
+    fn get(&mut self, resource: &[u8], res_id: Option<&[u8]>, out: &mut [u8]) -> Result<usize, u16>;
+    /// Takes the Property Data of a Set; gives a status on refusal.
+    fn set(&mut self, resource: &[u8], res_id: Option<&[u8]>, data: &[u8]) -> Result<(), u16>;
+}
+
+/// "resource" and "resId" of a header, decoded (escapes included), each at most 36 bytes, with
+/// the JSON rules of the slice walker. A value that is not a string gives an error.
+#[cfg(not(feature = "proto_full_header"))]
+struct Ids {
+    resource: [u8; 36],
+    resource_len: Option<usize>,
+    res_id: [u8; 36],
+    res_id_len: Option<usize>,
+}
+
+#[cfg(not(feature = "proto_full_header"))]
+fn ids(header: &[u8]) -> Result<Ids, ()> {
+    let mut ids = Ids { resource: [0; 36], resource_len: None, res_id: [0; 36], res_id_len: None };
+    crate::json::for_each_member_slice::<crate::json::JsonError>(header, |name, raw| {
+        match name {
+            Some(b"resource") => ids.resource_len = crate::json::Scan::decode_into(raw, &mut ids.resource),
+            Some(b"resId") => ids.res_id_len = crate::json::Scan::decode_into(raw, &mut ids.res_id),
+            _ => {}
+        }
+        Ok(())
+    })
+    .map_err(|_| ())?;
+    Ok(ids)
+}
+
+fn status_header(status: u16, out: &mut [u8; 16]) -> usize {
+    let prefix = b"{\"status\":";
+    out[..prefix.len()].copy_from_slice(prefix);
+    let mut n = prefix.len();
+    let digits = [status / 100, status / 10 % 10, status % 10];
+    for d in digits {
+        out[n] = b'0' + d as u8;
+        n += 1;
+    }
+    out[n] = b'}';
+    n + 1
+}
+
+/// Handles one event; writes each reply message into `out` and gives it to `send`.
+pub fn respond<const P: usize, const PR: usize, const R: usize, H: SimpleResources>(
+    dev: &mut CiDevice<'_, P, PR, R>,
+    ev: &Event<'_>,
+    list: &[u8],
+    host: &mut H,
+    body: &mut [u8],
+    out: &mut [u8],
+    mut send: impl FnMut(&[u8]),
+) {
+    let Event::PeChunk { muid, kind, chunk } = *ev else { return };
+    let reply_kind = match kind {
+        PeKind::GetInquiry => PeKind::GetReply,
+        PeKind::SetInquiry => PeKind::SetReply,
+        _ => return,
+    };
+    let (status, n) = if chunk.total != 1 || chunk.number != 1 {
+        (413, 0)
+    } else {
+        #[cfg(not(feature = "proto_full_header"))]
+        let parsed = ids(chunk.header).ok();
+        #[cfg(not(feature = "proto_full_header"))]
+        let (resource, res_id) = match parsed.as_ref() {
+            Some(p) => (
+                p.resource_len.map(|n| &p.resource[..n]),
+                p.res_id_len.map(|n| &p.res_id[..n]),
+            ),
+            None => (None, None),
+        };
+        #[cfg(feature = "proto_full_header")]
+        let parsed = crate::header::Header::parse(crate::header::HeaderKind::Inquiry, chunk.header).ok();
+        #[cfg(feature = "proto_full_header")]
+        let (resource, res_id) = match parsed.as_ref().and_then(|h| h.resource) {
+            Some(crate::header::HeaderStr::Raw(r)) => (Some(r), parsed.as_ref().and_then(|h| match h.res_id { Some(crate::header::HeaderStr::Raw(x)) => Some(x), _ => None })),
+            _ => (None, None),
+        };
+        match (resource, kind) {
+            (None, _) => (400, 0),
+            (Some(b"ResourceList"), PeKind::GetInquiry) => {
+                let n = list.len().min(body.len());
+                body[..n].copy_from_slice(&list[..n]);
+                (200, n)
+            }
+            (Some(r), PeKind::GetInquiry) => match host.get(r, res_id, body) {
+                Ok(n) => (200, n),
+                Err(s) => (s, 0),
+            },
+            (Some(r), _) => match host.set(r, res_id, chunk.data) {
+                Ok(()) => (200, 0),
+                Err(s) => (s, 0),
+            },
+        }
+    };
+    let mut h = [0u8; 16];
+    let hn = status_header(status, &mut h);
+    let Ok(mut w) = dev.pe_reply(muid, reply_kind, chunk.request_id, &h[..hn], Some(n), None) else {
+        return;
+    };
+    let mut at = 0;
+    loop {
+        let room = w.data_room().min(n - at);
+        match w.write_next(&body[at..at + room], out) {
+            Ok(k) => send(&out[..k]),
+            Err(_) => break,
+        }
+        at += room;
+        if at >= n {
+            break;
+        }
+    }
+    let _: Muid = muid;
+}
