+// ---- PROTOTYPE (size experiment): a slice-based member walker for a complete JSON object.
+/// [`for_each_member`] for bytes that hold the whole object: the same calls of `f` and the same
+/// errors, with no streaming reader. Names are decoded into 24 bytes; a longer name, or one with
+/// a character that is not ASCII, is given as `None`.
+pub(crate) fn for_each_member_slice<'a, E: From<JsonError>>(
+    bytes: &'a [u8],
+    mut f: impl FnMut(Option<&[u8]>, &'a [u8]) -> Result<(), E>,
+) -> Result<(), E> {
+    let mut s = Scan { b: bytes, i: 0 };
+    s.ws();
+    if s.next() != Some(b'{') {
+        return Err(JsonError::Syntax.into());
+    }
+    s.ws();
+    if s.peek() == Some(b'}') {
+        s.i += 1;
+    } else {
+        loop {
+            let mut name = [0u8; 24];
+            let n = s.name(&mut name)?;
+            s.ws();
+            if s.next() != Some(b':') {
+                return Err(JsonError::Syntax.into());
+            }
+            s.ws();
+            let start = s.i;
+            s.value(1)?;
+            let raw = &bytes[start..s.i];
+            f(n.map(|n| &name[..n]), raw)?;
+            s.ws();
+            match s.next() {
+                Some(b',') => s.ws(),
+                Some(b'}') => break,
+                _ => return Err(JsonError::Syntax.into()),
+            }
+        }
+    }
+    s.ws();
+    if s.i != bytes.len() {
+        return Err(JsonError::Syntax.into());
+    }
+    Ok(())
+}
+
+pub(crate) struct Scan<'a> {
+    b: &'a [u8],
+    i: usize,
+}
+
+impl Scan<'_> {
+    fn peek(&self) -> Option<u8> {
+        self.b.get(self.i).copied()
+    }
+    fn next(&mut self) -> Option<u8> {
+        let c = self.peek()?;
+        self.i += 1;
+        Some(c)
+    }
+    fn ws(&mut self) {
+        while matches!(self.peek(), Some(b' ' | b'\t' | b'\n' | b'\r')) {
+            self.i += 1;
+        }
+    }
+    fn hex4(&mut self) -> Result<u16, JsonError> {
+        let mut v = 0u16;
+        for _ in 0..4 {
+            let d = match self.next() {
+                Some(c @ b'0'..=b'9') => c - b'0',
+                Some(c @ b'a'..=b'f') => c - b'a' + 10,
+                Some(c @ b'A'..=b'F') => c - b'A' + 10,
+                _ => return Err(JsonError::Syntax),
+            };
+            v = v << 4 | u16::from(d);
+        }
+        Ok(v)
+    }
+    /// A string; each decoded ASCII byte goes to `put` (None for a character that is not ASCII).
+    fn string(&mut self, mut put: impl FnMut(Option<u8>)) -> Result<(), JsonError> {
+        if self.next() != Some(b'"') {
+            return Err(JsonError::Syntax);
+        }
+        loop {
+            match self.next().ok_or(JsonError::Syntax)? {
+                b'"' => return Ok(()),
+                b'\\' => {
+                    let c = match self.next().ok_or(JsonError::Syntax)? {
+                        b'"' => b'"',
+                        b'\\' => b'\\',
+                        b'/' => b'/',
+                        b'b' => 8,
+                        b'f' => 12,
+                        b'n' => b'\n',
+                        b'r' => b'\r',
+                        b't' => b'\t',
+                        b'u' => {
+                            let v = self.hex4()?;
+                            put(u8::try_from(v).ok().filter(u8::is_ascii));
+                            continue;
+                        }
+                        _ => return Err(JsonError::Syntax),
+                    };
+                    put(Some(c));
+                }
+                c if c < 0x20 => return Err(JsonError::Syntax),
+                c => put(Some(c).filter(u8::is_ascii)),
+            }
+        }
+    }
+    /// Decodes the string at the start of `raw` (a token that the walker checked) into `out`;
+    /// None when it is longer than `out` or has a character that is not ASCII.
+    pub(crate) fn decode_into(raw: &[u8], out: &mut [u8]) -> Option<usize> {
+        let mut s = Scan { b: raw, i: 0 };
+        let (mut n, mut ok) = (0usize, true);
+        s.string(|c| match (c, out.get_mut(n)) {
+            (Some(c), Some(slot)) => {
+                *slot = c;
+                n += 1;
+            }
+            _ => ok = false,
+        })
+        .ok()?;
+        ok.then_some(n)
+    }
+
+    fn name(&mut self, out: &mut [u8; 24]) -> Result<Option<usize>, JsonError> {
+        let mut n = 0usize;
+        let mut ok = true;
+        self.string(|c| match c {
+            Some(c) if n < 24 => {
+                out[n] = c;
+                n += 1;
+            }
+            _ => ok = false,
+        })?;
+        Ok(ok.then_some(n))
+    }
+    fn digits(&mut self) -> usize {
+        let s = self.i;
+        while matches!(self.peek(), Some(b'0'..=b'9')) {
+            self.i += 1;
+        }
+        self.i - s
+    }
+    fn value(&mut self, depth: u8) -> Result<(), JsonError> {
+        match self.peek().ok_or(JsonError::Syntax)? {
+            b'"' => self.string(|_| {}),
+            b'{' | b'[' => {
+                if depth >= MAX_DEPTH {
+                    return Err(JsonError::Depth);
+                }
+                let close = if self.next() == Some(b'{') { b'}' } else { b']' };
+                self.ws();
+                if self.peek() == Some(close) {
+                    self.i += 1;
+                    return Ok(());
+                }
+                loop {
+                    if close == b'}' {
+                        self.string(|_| {})?;
+                        self.ws();
+                        if self.next() != Some(b':') {
+                            return Err(JsonError::Syntax);
+                        }
+                        self.ws();
+                    }
+                    self.value(depth + 1)?;
+                    self.ws();
+                    match self.next() {
+                        Some(b',') => self.ws(),
+                        Some(c) if c == close => return Ok(()),
+                        _ => return Err(JsonError::Syntax),
+                    }
+                }
+            }
+            b't' | b'f' | b'n' => {
+                for lit in [&b"true"[..], b"false", b"null"] {
+                    if self.b[self.i..].starts_with(lit) {
+                        self.i += lit.len();
+                        return Ok(());
+                    }
+                }
+                Err(JsonError::Syntax)
+            }
+            _ => {
+                // Number: -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
+                if self.peek() == Some(b'-') {
+                    self.i += 1;
+                }
+                match self.peek() {
+                    Some(b'0') => self.i += 1,
+                    Some(b'1'..=b'9') => {
+                        self.digits();
+                    }
+                    _ => return Err(JsonError::Syntax),
+                }
+                if self.peek() == Some(b'.') {
+                    self.i += 1;
+                    if self.digits() == 0 {
+                        return Err(JsonError::Syntax);
+                    }
+                }
+                if matches!(self.peek(), Some(b'e' | b'E')) {
+                    self.i += 1;
+                    if matches!(self.peek(), Some(b'+' | b'-')) {
+                        self.i += 1;
+                    }
+                    if self.digits() == 0 {
+                        return Err(JsonError::Syntax);
+                    }
+                }
+                Ok(())
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod proto_slice_tests {
+    extern crate std;
+    use super::*;
+    use proptest::prelude::*;
+    use std::string::ToString;
+    use std::vec;
+    use std::vec::Vec;
+
+    fn members(bytes: &[u8], slice: bool) -> Result<Vec<(Option<std::string::String>, Vec<u8>)>, JsonError> {
+        let mut v = Vec::new();
+        if slice {
+            for_each_member_slice(bytes, |n: Option<&[u8]>, raw: &[u8]| -> Result<(), JsonError> {
+                v.push((n.map(|n| std::string::String::from_utf8(n.to_vec()).unwrap()), raw.to_vec()));
+                Ok(())
+            })?;
+        } else {
+            for_each_member(bytes, |n: Option<&str>, raw: &[u8]| -> Result<(), JsonError> {
+                v.push((n.map(std::string::String::from), raw.to_vec()));
+                Ok(())
+            })?;
+        }
+        Ok(v)
+    }
+
+    fn header() -> impl Strategy<Value = Vec<u8>> {
+        let key = prop_oneof![Just("resource"), Just("resId"), Just("offset"), Just("limit"), Just("status"),
+            Just("mutualEncoding"), Just("setPartial"), Just("command"), Just("x"), Just("res\\u0049d"), Just("aaaaaaaaaaaaaaaaaaaaaaaaaaa")];
+        let val = prop_oneof![Just("\"X-State\"".to_string()), Just("12".to_string()), Just("-0.5e3".to_string()),
+            Just("true".to_string()), Just("null".to_string()), Just("{\"a\":[1,2,{\"b\":\"c\\\"d\"}]}".to_string()),
+            Just("\"\\ud800x\"".to_string()), Just("\"caf\u{e9}\"".to_string()), Just("[]".to_string())];
+        proptest::collection::vec((key, val, prop_oneof![Just(""), Just(" "), Just("\n\t")]), 0..6).prop_map(|m| {
+            let body: Vec<std::string::String> = m.iter().map(|(k, v, w)| std::format!("{w}\"{k}\"{w}:{w}{v}{w}")).collect();
+            std::format!("{{{}}}", body.join(",")).into_bytes()
+        })
+    }
+
+    #[test]
+    fn prop_slice_walker_equals_streaming_walker() {
+        use crate::header::{Header, HeaderKind};
+        proptest!(ProptestConfig::with_cases(30_000), |(h in header(), cut in 0usize..200, b in 0u8..0x80, mode in 0u8..3)| {
+            let mut m = h.clone();
+            if !m.is_empty() {
+                let i = cut % m.len();
+                match mode { 0 => {}, 1 => m[i] = b, _ => { m.truncate(i); } }
+            }
+            // The same header, or two errors with the same reply status (415 or 400).
+            let status = |e: &crate::header::HeaderError| matches!(e, crate::header::HeaderError::Invalid("mutualEncoding" | "mediaType"));
+            for kind in [HeaderKind::Inquiry, HeaderKind::Reply, HeaderKind::Subscription] {
+                let (a, b) = (Header::parse_with(kind, &m, true), Header::parse_with(kind, &m, false));
+                use crate::header::HeaderError as HE;
+                match (&a, &b) {
+                    // Allowed: the new walker finds the JSON error before the old one gave a
+                    // property error for a value cut at the end (old defect).
+                    (Err(HE::Json(_)), Err(_)) => {}
+                    (Err(x), Err(y)) => prop_assert_eq!(status(x), status(y), "{:?} {:?} {:?}", x, y, std::string::String::from_utf8_lossy(&m)),
+                    _ => prop_assert_eq!(&a, &b, "{:?}", std::string::String::from_utf8_lossy(&m)),
+                }
+            }
+        });
+    }
+
+    #[test]
+    fn slice_walker_does_not_take_a_damaged_name() {
+        use crate::header::{Header, HeaderKind};
+        let h = b"{\"resource\xFF\":\"A\"}";
+        assert!(Header::parse_with(HeaderKind::Inquiry, h, false).is_ok(), "old: taken as resource");
+        assert!(Header::parse_with(HeaderKind::Inquiry, h, true).is_err(), "new: no resource");
+    }
+
+    #[test]
+    fn old_reader_names_with_invalid_bytes() {
+        for h in [&b"{\"res\xFFource\":\"A\"}"[..], b"{\"\xFFresource\":\"A\"}", b"{\"resource\xFF\":\"A\"}"] {
+            std::println!("{:?} -> {:?}", std::string::String::from_utf8_lossy(h), members(h, false));
+        }
+    }
+
+    #[test]
+    fn prop_slice_walker_equals_streaming_walker_on_any_bytes() {
+        proptest!(ProptestConfig::with_cases(30_000), |(m in proptest::collection::vec(0u8..0x80, 0..40))| {
+            prop_assert_eq!(members(&m, true), members(&m, false));
+        });
+    }
+}
