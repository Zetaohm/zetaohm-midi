+// ---- PROTOTYPE (size experiment): word-level MIDI 2.0 to 1.0, no Ump value.
+/// MIDI 1.0 words of one MIDI 2.0 Channel Voice packet (D.2). Other packets give themselves.
+pub fn to_midi1_words(w: &[u32], out: &mut [u32; 4]) -> usize {
+    let Some(&w0) = w.first() else { return 0 };
+    if w0 >> 28 != 0x4 {
+        out[0] = w0;
+        return 1;
+    }
+    let Some(&w1) = w.get(1) else { return 0 };
+    let head = 0x2000_0000 | (w0 & 0x0F0F_0000);
+    let (b2, b3) = ((w0 >> 8) & 0x7F, w0 & 0x7F);
+    let m1 = |status: u32, d0: u32, d1: u32| head | status << 20 | (d0 & 0x7F) << 8 | (d1 & 0x7F);
+    let mut n = 0;
+    let mut put = |x: u32| {
+        if let Some(s) = out.get_mut(n) {
+            *s = x;
+            n += 1;
+        }
+    };
+    let mut param = |put: &mut dyn FnMut(u32), sel: [u32; 2], v: u32| {
+        put(m1(0xB, sel[0], b2));
+        put(m1(0xB, sel[1], b3));
+        put(m1(0xB, 6, v >> 7));
+        put(m1(0xB, 38, v));
+    };
+    match (w0 >> 20) & 0xF {
+        0x8 => put(m1(0x8, b2, down(w1 >> 16, 16, 7))),
+        0x9 => put(m1(0x9, b2, down(w1 >> 16, 16, 7).max(1))),
+        0xA => put(m1(0xA, b2, down(w1, 32, 7))),
+        0xB => put(m1(0xB, b2, down(w1, 32, 7))),
+        0x2 => {
+            let v = if zero_extension(b3 as u8) {
+                zero_extend_downscale(w1, 32, 14).unwrap_or(0)
+            } else {
+                down(w1, 32, 14)
+            };
+            param(&mut put, [101, 100], v)
+        }
+        0x3 => param(&mut put, [99, 98], down(w1, 32, 14)),
+        0xC => {
+            if w0 & 1 != 0 {
+                put(m1(0xB, 0, w1 >> 8));
+                put(m1(0xB, 32, w1));
+            }
+            put(m1(0xC, w1 >> 24, 0));
+        }
+        0xD => put(m1(0xD, down(w1, 32, 7), 0)),
+        0xE => {
+            let v = down(w1, 32, 14);
+            put(m1(0xE, v, v >> 7))
+        }
+        _ => {}
+    }
+    n
+}
