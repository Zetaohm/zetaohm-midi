+    pub fn write<Bus: UsbBus, const EPS: usize>(
+        writer: &mut DescriptorWriter,
+        ac_if: InterfaceNumber,
+        ms_if: InterfaceNumber,
+        names: &[Option<(StringIndex, &str)>],
+        outs: &[Option<EndpointOut<'_, Bus>>; EPS],
+        ins: &[Option<EndpointIn<'_, Bus>>; EPS],
+    ) -> Result<(), UsbError> {
+        let mut d: &[u8] = &FIXED;
+        while let [len, ty, ..] = *d {
+            let (one, rest) = d.split_at(usize::from(len).min(d.len()));
+            d = rest;
