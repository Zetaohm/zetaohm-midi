+                        let ep = outs.iter().flatten().find(|e| u8::from(e.address()) == one[2]).ok_or(UsbError::InvalidState)?;
+                        writer.endpoint_ex(ep, copy)?;
+                    }
+                }
+                _ => writer.write(ty, &one[2..])?,
+            }
+        }
+        Ok(())
+    }
+}
