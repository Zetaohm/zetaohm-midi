+// ---- PROTOTYPE (size experiment): word-level reader and writer.
+/// Packets given by one [`BytesToUmpCore::push_words`]: at most two of at most 2 words.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct PushedWords {
+    w: [[u32; 2]; 2],
+    n: [u8; 2],
+    len: u8,
+}
+impl PushedWords {
+    fn add(&mut self, w: [u32; 2], n: u8) {
+        if let Some(i) = (self.len < 2).then_some(self.len as usize) {
+            self.w[i] = w;
+            self.n[i] = n;
+            self.len += 1;
+        }
+    }
+    /// PROTOTYPE: the words of typed UMPs.
+    pub fn from_umps(p: Pushed) -> Self {
+        let mut out = Self::default();
+        for u in p {
+            let mut w = [0u32; 4];
+            if let Ok(n) = u.write(&mut w) {
+                out.add([w[0], w[1]], n.min(2) as u8);
+            }
+        }
+        out
+    }
+    /// Packet `i`.
+    pub fn get(&self, i: usize) -> Option<&[u32]> {
+        (i < self.len as usize).then(|| &self.w[i][..self.n[i] as usize])
+    }
+}
+
+impl BytesToUmpCore {
+    /// [`Self::push_with`] with no translator, words out.
+    pub fn push_words(&mut self, byte: u8) -> PushedWords {
+        let mut out = PushedWords::default();
+        let g = self.group;
+        let one = |mt, s, d0, d1| [word(mt, g, s, d0, d1), 0];
+        match byte {
+            0xF8..=0xFF => {
+                if !undefined(byte) {
+                    out.add(one(0x1, byte, 0, 0), 1);
+                }
+            }
+            0x80..=0xF7 => {
+                if self.in_sysex {
+                    let s = if self.started { 3 } else { 0 };
+                    out.add(self.sysex_words(s), 2);
+                    self.in_sysex = false;
+                }
+                self.status = 0;
+                self.count = 0;
+                match byte {
+                    0x80..=0xEF => {
+                        self.running = byte;
+                        self.status = byte;
+                    }
+                    SOX => {
+                        self.running = 0;
+                        self.in_sysex = true;
+                        self.chunk_len = 0;
+                        self.started = false;
+                    }
+                    0xF6 => {
+                        self.running = 0;
+                        out.add(one(0x1, byte, 0, 0), 1);
+                    }
+                    _ => {
+                        self.running = 0;
+                        if data_len(byte) > 0 {
+                            self.status = byte;
+                        }
+                    }
+                }
+            }
+            _ => {
+                if self.in_sysex {
+                    if self.chunk_len == self.chunk.len() {
+                        let s = if self.started { 2 } else { 1 };
+                        out.add(self.sysex_words(s), 2);
+                        self.started = true;
+                    }
+                    self.chunk[self.chunk_len] = byte;
+                    self.chunk_len += 1;
+                    return out;
+                }
+                if self.status == 0 {
+                    if self.running == 0 {
+                        return out;
+                    }
+                    self.status = self.running;
+                    self.count = 0;
+                }
+                self.data[self.count] = byte;
+                self.count += 1;
+                if self.count == data_len(self.status) {
+                    let (status, d0, d1) = (self.status, self.data[0], self.data[1]);
+                    let d1 = if self.count == 2 { d1 } else { 0 };
+                    self.status = 0;
+                    self.count = 0;
+                    let mt = if status < 0xF0 { 0x2 } else { 0x1 };
+                    out.add(one(mt, status, d0, d1), 1);
+                }
+            }
+        }
+        out
+    }
+
+    /// SysEx7 words of the pending data (status 0 Complete, 1 Start, 2 Continue, 3 End).
+    fn sysex_words(&mut self, status: u32) -> [u32; 2] {
+        let mut b = [0u8; 8];
+        b[0] = 0x30 | self.group.into_bits();
+        b[1] = (status << 4) as u8 | self.chunk_len as u8;
+        b[2..2 + self.chunk_len].copy_from_slice(&self.chunk[..self.chunk_len]);
+        self.chunk_len = 0;
+        [u32::from_be_bytes([b[0], b[1], b[2], b[3]]), u32::from_be_bytes([b[4], b[5], b[6], b[7]])]
+    }
+}
+
+impl UmpToBytes {
+    /// [`Self::write`] from the words, with no `Ump::parse`.
+    pub fn write_words(&mut self, words: &[u32], out: &mut [u8]) -> Result<usize, ByteStreamError> {
+        let Some(&w0) = words.first() else { return Ok(0) };
+        let mut bytes = Bytes::default();
+        let mut last = self.last_status;
+        match w0 >> 28 {
+            0x1 => {
+                let status = (w0 >> 16) as u8;
+                if matches!(status, 0xF1..=0xF3 | 0xF6 | 0xF8 | 0xFA..=0xFC | 0xFE | 0xFF) {
+                    bytes.push(status);
+                    if status < 0xF8 {
+                        last = 0;
+                        for i in 0..data_len(status) {
+                            bytes.push((w0 >> (8 - 8 * i)) as u8 & 0x7F);
+                        }
+                    }
+                }
+            }
+            0x2 if (w0 >> 16) as u8 >= 0x80 && (w0 >> 16) as u8 <= 0xEF => {
+                self.channel(w0, &mut last, &mut bytes)
+            }
+            0x4 => {
+                let mut m = [0u32; 4];
+                let n = zmidi_ump::to_midi1_words(words, &mut m);
+                for &w in &m[..n] {
+                    self.channel(w, &mut last, &mut bytes);
+                }
+            }
+            0x3 if words.len() >= 2 && (w0 >> 20) & 0xF <= 3 && (w0 >> 16) & 0xF <= 6 => {
+                let status = (w0 >> 20) & 0xF;
+                let n = ((w0 >> 16) & 0xF) as usize;
+                if status <= 1 {
+                    bytes.push(SOX);
+                    last = 0;
+                }
+                let b = [(w0 >> 8) as u8, w0 as u8];
+                let c = words[1].to_be_bytes();
+                for &x in b.iter().chain(c.iter()).take(n) {
+                    bytes.push(x & 0x7F);
+                }
+                if status == 0 || status == 3 {
+                    bytes.push(EOX);
+                }
+            }
+            _ => {}
+        }
+        let src = bytes.as_slice();
+        let dst = out.get_mut(..src.len()).ok_or(ByteStreamError::BufferTooSmall)?;
+        dst.copy_from_slice(src);
+        self.last_status = last;
+        Ok(src.len())
+    }
+}
