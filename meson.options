# Options of the Meson package of the C ABI (crates/zmidi-ffi/meson.build).
option('features', type: 'array', value: ['io'],
  description: 'Parts of the C ABI (Cargo features of zmidi-ffi), for example io, ump, ble, file, ci, net, net-auth, usb, midi1')
option('cargo_target', type: 'string', value: '',
  description: 'Rust target triple; empty for the host. A cross build needs it, for example thumbv7em-none-eabihf')
option('runtime', type: 'combo', choices: ['auto', 'std', 'panic-handler'], value: 'auto',
  description: 'std for a host, panic-handler for bare metal and wasm32-unknown-unknown; auto selects by cargo_target')
option('tests', type: 'boolean', value: false,
  description: 'Build the C tests (host: meson test) or the bare-metal link checks (cross build)')
